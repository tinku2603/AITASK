# ========================================================
# AGENTIC EXPENSE TRACKER - ENVIRONMENT CONFIGURATION
# ========================================================

# 1. LLM Vision & Extraction Provider Selection
# Options: 'gemini' | 'groq' | 'ollama' | 'llamacpp' | 'mock'
NEXT_PUBLIC_LLM_PROVIDER="gemini"

# Google Gemini Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Groq API Configuration (Ultra-fast Vision & Reasoning)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_API_BASE="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.2-11b-vision-preview"

# Local Ollama Configuration (Gemma / Llama / Qwen)
OLLAMA_API_BASE="http://localhost:11434/v1"
OLLAMA_MODEL="gemma2"

# Local llama.cpp Server (OpenAI-compatible)
LLAMACPP_API_BASE="http://localhost:8080/v1"
LLAMACPP_MODEL="default"

# 2. Supabase PostgreSQL + pgvector Configuration
# Find these in your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
